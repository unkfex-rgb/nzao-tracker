# Supabase > Project Settings > API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=COLE_A_SERVICE_ROLE_KEY

# Apify token + actor. O formato da entrada depende do actor escolhido.
APIFY_TOKEN=COLE_SEU_TOKEN
APIFY_ACTOR_ID=SEU_ACTOR_ID
# JSON de entrada específico do actor. Consulte a documentação do actor.
APIFY_INPUT_JSON={"hashtags":["nzao","nzao10k"],"resultsPerPage":100}

# Segredo para proteger a rota de coleta/cron
CRON_SECRET=CRIE_UM_SEGREDO_LONGO_ALEATORIO
